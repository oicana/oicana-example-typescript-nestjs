{
  "name": "oicana-example-typescript-nestjs",
  "version": "0.0.1",
  "description": "Example application using the Oicana Node.js integration for PDF templating",
  "repository": {
    "type": "git",
    "url": "https://github.com/oicana/oicana-example-typescript-nestjs"
  },
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "tsc": "tsc",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/swagger": "12.0.2",
    "@oicana/node": "0.9.0",
    "neverthrow": "8.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "13.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.7",
    "@nestjs/schematics": "12.0.5",
    "@nestjs/testing": "12.1.0",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "22.20.4",
    "@types/supertest": "7.2.1",
    "oxlint": "1.85.0",
    "prettier": "3.4.2",
    "source-map-support": "0.5.21",
    "supertest": "7.3.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "type": "module"
}
